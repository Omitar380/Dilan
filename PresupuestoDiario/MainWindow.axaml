<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:PresupuestoDiario.Models"
        x:Class="PresupuestoDiario.MainWindow"
        Title="PresupuestoDiario — Gastos e Ingresos Personales"
        Width="960" Height="580"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="340,*" Margin="20" ColumnSpacing="20">
        <!-- Columna Izquierda: Registro y Edición -->
        <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="9">
                <TextBlock Text="Nuevo / Editar Movimiento" FontSize="18" FontWeight="Bold"/>

                <TextBlock Text="Tipo:"/>
                <ComboBox x:Name="CmbTipo" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="CmbTipo_SelectionChanged">
                    <ComboBoxItem Content="Ingreso"/>
                    <ComboBoxItem Content="Gasto"/>
                </ComboBox>

                <TextBlock Text="Concepto:"/>
                <TextBox x:Name="TxtConcepto" PlaceholderText="Ej. Almuerzo / Transporte"/>

                <TextBlock Text="Categoría:"/>
                <TextBox x:Name="TxtCategoria" PlaceholderText="Ej. Alimentación / Hogar"/>

                <TextBlock x:Name="LblDetalle" Text="Medio de pago:"/>
                <TextBox x:Name="TxtDetalle" PlaceholderText="Ej. Efectivo / Transferencia"/>

                <TextBlock Text="Fecha (AAAA-MM-DD):"/>
                <TextBox x:Name="TxtFecha" PlaceholderText="2026-11-20"/>

                <TextBlock Text="Monto:"/>
                <TextBox x:Name="TxtMonto" PlaceholderText="Ej. 15000"/>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="BtnGuardar" Content="Guardar" Click="BtnGuardar_Click" Background="#16A34A" Foreground="White"/>
                    <Button x:Name="BtnActualizar" Content="Actualizar" Click="BtnActualizar_Click"/>
                    <Button x:Name="BtnLimpiar" Content="Limpiar" Click="BtnLimpiar_Click"/>
                </StackPanel>

                <TextBlock x:Name="TxtMensaje" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Columna Derecha: Resumen y Movimientos -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <TextBlock Grid.Row="0" Text="Resumen general y saldo" FontSize="18" FontWeight="Bold"/>

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Background="#ECFDF5" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Ingresos" FontSize="12" Foreground="#166534"/>
                        <TextBlock x:Name="TxtTotalIngresos" Text="$0" FontSize="18" FontWeight="Bold" Foreground="#15803D"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Gastos" FontSize="12" Foreground="#991B1B"/>
                        <TextBlock x:Name="TxtTotalGastos" Text="$0" FontSize="18" FontWeight="Bold" Foreground="#DC2626"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Saldo Disponible" FontSize="12" Foreground="#1E40AF"/>
                        <TextBlock x:Name="TxtSaldo" Text="$0" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ListBox Grid.Row="2" x:Name="LstMovimientos" SelectionChanged="LstMovimientos_SelectionChanged" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:MovimientoFinanciero">
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Concepto}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock FontSize="12" Foreground="#555555">
                                <Run Text="{Binding Tipo}"/>
                                <Run Text=" | "/>
                                <Run Text="{Binding Categoria}"/>
                                <Run Text=" | Fecha: "/>
                                <Run Text="{Binding Fecha}"/>
                                <Run Text=" | Monto: $"/>
                                <Run Text="{Binding Monto}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="3" x:Name="BtnEliminar" Content="Eliminar Seleccionado" HorizontalAlignment="Right" Click="BtnEliminar_Click" Background="#DC2626" Foreground="White"/>
        </Grid>
    </Grid>
</Window>